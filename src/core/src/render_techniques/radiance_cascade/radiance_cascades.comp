/*- direction mapping: 
 *  source <https://www.shadertoy.com/view/4cjczV> -*/
#define OCTAHERDAL_MIRROR 0

float3 octahedral_unmap(float2 e)
{
#if OCTAHEDRAL_MIRROR
    /* Source: <https://www.shadertoy.com/view/MdsfzN> */
    float2 m = abs(e - 0.5) + 0.5;
    float2 f = floor(m);
    float x = f.x - f.y;
    bool mirror = (x != 0.0); 
    if (mirror) e.xy = 1.0-e.xy;
#endif
    /* Provided by Alexander Sannikov */
    e = frac(e);
    e = e * 2.0 - 1.0;
    float3 v = float3(e.xy, 1.0 - abs(e.x) - abs(e.y));
    if (v.z < 0.0)
        v.xy = (1.0 - abs(v.yx)) * sign(v.xy);
    return normalize(v);
}
/* Provided by Alexander Sannikov */
float3 costheta_unmap(float2 uv)
{
    float phi = uv.x * 2.0 * PI;
    float theta = uv.y * PI;
    return float3(float2(sin(phi), cos(phi)) * sin(theta), cos(theta));
}
/* Decode UV *(-1.0 -> 1.0)* coordinates into a direction. */
inline float3 oct_decode(const float2 e)
{
    #define copysign(a, b) ((a) * sign(b))
    /* Equal-Area Mapping <https://pbr-book.org/4ed/Geometry_and_Transformations/Spherical_Geometry#x3-Equal-AreaMapping> */
    const float2 v = abs(e);
    const float sdist = 1.0 - (v.x + v.y);
    const float r = 1.0 - abs(sdist);
    const float phi = ((v.y - v.x) / r + 1.0) * 0.785398;
    const float r_sqr = r * r;
    const float z = copysign(1.0 - r_sqr, sdist);
    const float cos_phi = copysign(cos(phi), e.x);
    const float sin_phi = copysign(sin(phi), e.y);
    const float r_scl = r * sqrt(2.0 - r_sqr);
    return float3(cos_phi * r_scl, sin_phi * r_scl, z).xyz;
}
/*- end direction mapping -*/


// idx: [0, sample_counts.x*sample_counts.y]
// sample_counts: sqrt(rays per pixel)
float2 index_to_uv_offset(uint idx, uint2 sample_counts) 
{
    float2 sample_idx = float2(idx % sample_counts.x, idx / sample_counts.x) + 0.5; // [0.5,sample_counts-0.5] eg [0.5, 3.5] for sc=4,4
    sample_idx = sample_idx - 0.5 * float2(sample_counts); // [-sample_counts/2+0.5, sample_count/2-0.5] eg [-1.5,1.5] for sc=4,4
    return sample_idx / sample_counts; //[-0.5+0.5/sample_counts, 0.5-0.5/sample_counts] eg [-3/8, 3/8] for sc=4,4
}


float3 index_to_direction(uint d, uint2 dir_counts, uint2 pos_in_probe, uint2 probe_size)
{
    //const uint2 dir_counts = sqrt(dir_count_per_pixel);
    float2 dir_offset = index_to_uv_offset(d, dir_counts);
    // get a ray direction for this pixel in the probe
    //float2 uv_in_probe = (pos_in_probe + 0.5 + 0.5*(BilinearOffset(d) - 0.5)) / probe_size; // this works for d in [0,3]
    float2 uv_in_probe = (pos_in_probe + 0.5 + dir_offset) / probe_size;
        
#if SPHERE_MAP_MODE == 1
    float3 direction = octahedral_unmap(uv_in_probe); 
#elif SPHERE_MAP_MODE == 2
    float3 direction = oct_decode(uv_in_probe * 2.0 - 1.0); // this is an equal-area version of the above octahedral mapping. 
#else
    float3 direction = costheta_unmap(uv_in_probe); 
#endif
    return direction;
}

float4 MergeInterval(float4 near, float4 far)
{
    const float3 radiance = near.rgb + (far.rgb * near.a);
    return float4(radiance, near.a * far.a);
}

struct TraceResult
{
    float4 radiance;
    float4 hit_point; // w is 1 if hit, 0 if miss ( NOTE: duplicated data from radiance.a )
};

TraceResult TraceInterval(float2 interval, float3 origin, float3 direction, bool is_max_cascade)
{
    float4 curr_radiance = float4(0.0, 0.0, 0.0, 1.0);
    
#if DEBUG_DIRECTIONS
        curr_radiance = float4(direction, 1.0);
#else
    RayDesc ray;
    ray.Direction = direction;
    ray.Origin = origin;
    ray.TMin = interval.x;
    ray.TMax = interval.y;

    float4 hit_point = float4(origin + direction * interval.y, 0.0);
    ClosestRayQuery query = TraceRay < ClosestRayQuery > (ray);
    if (query.CommittedStatus() != COMMITTED_NOTHING) // ray hit something
    {
        float t = query.CommittedRayT();
        HitInfo hit = GetHitInfoRtInlineCommitted(query);
        if (hit.frontFace)
        {
            IntersectData idata = MakeIntersectData(hit); // TODO: sample lights the correct way, if bounce lighting is even possible
            curr_radiance.rgb = GetRadiance(idata, ray).rgb * 1;
            //curr_radiance.rgb = ray.Direction;
            curr_radiance.a = 0.0; // occluded
        }
        else
        {
            curr_radiance.a = 0;
        }
        hit_point = float4(origin + direction * t, 1.0);
    }
    else if (is_max_cascade) // hit nothing, sample env. map if top cascade 
    {
#if DEBUG_DISABLE_ENV_MAP
        curr_radiance.rgb = 0;
#else
        curr_radiance.rgb = g_EnvironmentBuffer.SampleLevel(g_TextureSampler, ray.Direction, 0.0).rgb * 1.0;
#endif
        curr_radiance.a = 0; // this prevents propagating cMax sky samples when lower cascades' partially occluded ray groups merge with cMax
    }
#endif
    TraceResult res = { curr_radiance, hit_point };
    // this is the hackest hack i've ever done
//    if (direction.z == 0)
//    {
//        curr_radiance.a = 0; // axis aligned ray will never hit axis aligned wall
//    }
    return res;
}

void LeakingFix(inout float4 curr_radiance, float3 trace_end, uint2 nearest_upper_probe_id, uint2 upper_probe_size, uint2 pos_in_target_probe, uint layer)
{
    float3 ray_start = trace_end;
    RayDesc ray;
    ray.Origin = ray_start;
    ray.TMin = 0.0;
    
    float2 upper_probe_center_uv = ((nearest_upper_probe_id + 0.5) * upper_probe_size) / g_CascadeTexDimensions;
    float3 upper_probe_normal = normalize(2.0 * g_GeometryNormalBuffer.SampleLevel(g_NearestSampler, upper_probe_center_uv, 0).xyz - 1.0);
    float2 upper_probe_depths = g_MinMaxDepth.Load(int3(nearest_upper_probe_id, g_cascadeId + 2 - g_resolution_factor)).rg;
    TwoPos upper_probe_origin = GetRayOriginDepthAware(upper_probe_center_uv, upper_probe_normal, upper_probe_depths);
    float3 origins[2] = { upper_probe_origin.near, upper_probe_origin.far };
    
    float t = g_c0_length * IntervalScale(g_cascadeId + 1);
    
    float occlusion = 1;
    
    for (uint dir_index = 0; dir_index < 4; dir_index++)
    {
        uint2 pos_in_upper_probe = (nearest_upper_probe_id * upper_probe_size + BilinearOffset(dir_index) + 2 * pos_in_target_probe) % upper_probe_size;
        float3 direction = index_to_direction(dir_index, uint2(2, 2), pos_in_upper_probe, upper_probe_size);
        float3 ray_end = origins[layer] + t * direction;
        float3 ray_dir = ray_end - ray_start;
        ray.TMax = length(ray_dir);
        ray.Direction = normalize(ray_dir);
    
        ClosestRayQuery q = TraceRay < ClosestRayQuery > (ray);
        if (q.CommittedStatus() != COMMITTED_NOTHING)
        {
            occlusion -= 1.0/4/*0.25*/;
            
        }

    }
    curr_radiance.a *= occlusion;
}

void ReverseLeakingFix(inout float4 curr_radiance, float3 trace_to, uint2 probe_id, uint2 pos_in_probe, uint2 probe_size, uint layer)
{
    uint2 lower_probe_size = probe_size / 2;
    uint2 pos_in_lower_probe = pos_in_probe / 2;
    uint2 lower_probe_dir = pos_in_probe % 2;
    uint lower_probe_dir_index = lower_probe_dir.x + lower_probe_dir.y * lower_probe_size.x;
    float3 lower_direction = index_to_direction(lower_probe_dir_index, uint2(2, 2), pos_in_lower_probe, lower_probe_size);
    
    uint2 lower_probe_id = probe_id * 2 + lower_probe_dir;
    float2 lower_probe_uv = (lower_probe_id + 0.5) * lower_probe_size / g_CascadeTexDimensions;
    float3 lower_probe_normal = normalize(2.0 * g_GeometryNormalBuffer.SampleLevel(g_NearestSampler, lower_probe_uv, 0).xyz - 1.0);
    float2 lower_probe_depths = g_MinMaxDepth.Load(int3(lower_probe_id, g_cascadeId)).rg;
    TwoPos lower_probe_origins = GetRayOriginDepthAware(lower_probe_uv, lower_probe_normal, lower_probe_depths);
    float3 origins[2] = { lower_probe_origins.near, lower_probe_origins.far };
    
    float3 trace_from = origins[layer] + lower_direction * IntervalScale(g_cascadeId) * g_c0_length;
    float t = distance(trace_to, trace_from);
    float3 trace_direction = normalize(trace_to - trace_from);
    
    RayDesc ray;
    ray.Origin = trace_from;
    ray.TMin = 0.0;
    ray.Direction = trace_direction;
    ray.TMax = t;
    
    ClosestRayQuery query = TraceRay<ClosestRayQuery>(ray);
    
    if (query.CommittedStatus() != COMMITTED_NOTHING)
    {
        curr_radiance = MergeInterval(float4(0,0,0,0), curr_radiance);
    }

}

bool DumbLeakingFix_ShouldTrace(float3 origin)
{
    float3 projected_depth = transformPointProjection(origin, g_ViewProjection);
    float2 actual_depth = g_MinMaxDepth.SampleLevel(g_NearestSampler, (float2(1, -1) * projected_depth.xy) * 0.5 + 0.5, 0).xy;
    return projected_depth.z <= actual_depth.x;
}

float4 EdgeFunction(float4 depth_diffs)
{
    //return exp(-100 * depth_diffs);
    float4 ret = (1.0 / (1e3 * depth_diffs + 1e-1));
    ret *= pow(ret, g_cascadeId);
    //for (uint i = 0; i < min(g_cascadeId, 2); i++)
    //{
    //    ret = squared(ret);
    //}
    //if (g_cascadeId > 1)
    //{
    //    ret *= ret;
    //}
    return ret;
}

float4 MergeUpperRadiance(float4 traced_radiance, uint2 target_probe_pos, uint2 target_probe_size, uint2 pos_in_target_probe, uint target_dir_index, float target_probe_depth)
{
    const uint2 upper_probe_size = 2 * target_probe_size;
    const float2 one_over_res = 1.0 / float2(g_CascadeTexDimensions);
    #if 0 // this makes no discernable difference in quality or correctness
    uint2 nearest_upper_probe = target_probe_pos / 2; // 0,0 -> 0,0; 1,1 -> 0,0; 2,2 -> 1,1 etc. There are half as many probes in cN+1.
    uint2 pos_in_upper_probe = target_probe_pos % 2; // [0,1]
    uint2 upper_probe_tl = nearest_upper_probe - (1 - pos_in_upper_probe); 
    
    float2 ratio = frac(((target_probe_pos + 0.5) * target_probe_size) / float2(upper_probe_size) - 0.5); // Just assuming this is correct ¯\_(ツ)_/¯ its the same as BilinearSamples
    float4 weights = BilinearWeights(ratio);
    #else
    uint2 upper_probe_tl = 0;
    float4 weights = 0;
    BilinearSamples(((target_probe_pos + 0.5) * target_probe_size), upper_probe_size, weights, upper_probe_tl);
    #endif
    
    uint linear_dir_index = (pos_in_target_probe.x + pos_in_target_probe.y * target_probe_size.x) * 4;
    uint upper_dir_index = linear_dir_index + target_dir_index;
    //uint2 dir_offset = uint2(upper_dir_index % upper_probe_size.x, upper_dir_index / upper_probe_size.x);
    uint2 dir_offset = BilinearOffset(target_dir_index) + 2 * pos_in_target_probe;
    
#if BILATERAL_UPSAMPLING
    float2 probe_center_uv = (target_probe_pos + 0.5) * target_probe_size * one_over_res;
    float4 upper_probe_depths = 0;
    for (uint d = 0; d < 4; d++)
    {
        uint2 offset = BilinearOffset(d);
        uint2 upper_probe_id = upper_probe_tl + offset;
        
        #if PROBE_PLACEMENT == 0
        float upper_depth = LinearizeDepth(g_MinMaxDepth.Load(int3(upper_probe_id, g_cascadeId + 2 - g_resolution_factor)).r); // TODO: Does this *need* to be linearized?? Check other places as well
        #elif PROBE_PLACEMENT == 1
        float upper_depth = LinearizeDepth(g_MinMaxDepth.Load(int3(upper_probe_id, 0)).r);
        #endif
        upper_probe_depths[d] = upper_depth;
    }
    float maxd = hmax(upper_probe_depths);
    float mind = hmin(upper_probe_depths);
    float diffd = maxd - mind;
    float avg = dot(upper_probe_depths, 0.25.xxxx);
    bool d_edge = (diffd / avg) > 0.0075;
    
    float4 dd = abs(upper_probe_depths - LinearizeDepth(target_probe_depth));
    if (d_edge)
    {
        float4 edge_fn = EdgeFunction(dd);
        weights *= edge_fn;
    }
    
    //float maxw = hmax(dd);
    ////float minw = hmin(dd);
    ////float diffw = maxw - minw;
    ////float wavg = dot(weights, 0.25.xxxx);
    //if (all(weights < 1e-16) && maxw > 0.95)
    //{
    //    return MergeInterval(traced_radiance, 0.xxxx);
    //}
    
    weights /= hadd(weights); // normalize so total is 1 // BUG: this means weights close to [0,0,0,0] are treated the same as weights close to [1,1,1,1], there's no way to have zero contribution from upper probes
#endif
    
    float4 upper_radiance = 0.0;
    for (uint i = 0; i < 4; i++) // for each upper probe
    {
        uint2 offset = BilinearOffset(i);
        uint2 upper_probe_id = upper_probe_tl + offset;
        uint2 upper_probe_start_texel = upper_probe_id * upper_probe_size;
        uint2 sample_texel = upper_probe_start_texel + dir_offset;
        float4 upper_probe_radiance = g_lastCascade_min.Load(int3(sample_texel, 0));
        float weight = weights[i];
               
        //upper_radiance.rgb += upper_probe_radiance.rgb * weight;
        //upper_radiance.a += upper_probe_radiance.a * 0.25;
        upper_radiance += upper_probe_radiance * weight;
    }

    return MergeInterval(traced_radiance, upper_radiance);
}

float4 MinMaxMergeUpper(uint layer, float4 traced_radiance, uint2 target_probe_pos, uint2 target_probe_size, uint2 pos_in_target_probe, uint target_dir_index, float target_probe_depth)
{
    const uint2 upper_probe_size = 2 * target_probe_size;
    const float2 one_over_res = 1.0 / float2(g_CascadeTexDimensions);
    uint2 upper_probe_tl = 0;
    float4 weights = 0;
    BilinearSamples(((target_probe_pos + 0.5) * target_probe_size), upper_probe_size, weights, upper_probe_tl);
    
    float4 upper_probe_depths[2] = { 0.xxxx, 0.xxxx };
    for (uint i = 0; i < 4; i++)
    {
        uint2 upper_probe_id = upper_probe_tl + BilinearOffset(i);
        float2 upper_probe_center_uv = (upper_probe_id + 0.5) * upper_probe_size * one_over_res; 
        float2 upper_depths = LinearizeDepth(g_MinMaxDepth.SampleLevel(g_NearestSampler, upper_probe_center_uv, g_cascadeId+2-g_resolution_factor).rg); 
        //float2 upper_depths = /*LinearizeDepth*/(g_MinMaxDepth.Load(int3(upper_probe_id, g_cascadeId + 2 - g_resolution_factor)).rg); // BUG: using Load here misses bottom and right edges
        upper_probe_depths[0][i] = upper_depths.r;
        upper_probe_depths[1][i] = upper_depths.g;
    }
    
    //float maxd = dot(upper_probe_depths[1], 0.25.xxxx);
    //float mind = dot(upper_probe_depths[0], 0.25.xxxx);
    //float diffd = maxd - mind;
    //float avg = (maxd + mind) * 0.5;
    //bool d_edge = (diffd / avg) > 0.02;
    
    
    
    float4 depth_diffs = abs(upper_probe_depths[1] - upper_probe_depths[0]);
    float4 depth_weights = ((LinearizeDepth(target_probe_depth) - upper_probe_depths[0]) / depth_diffs); 
    
    bool4 skip_probes = or(depth_weights < -1.0 - FLT_EPSILON, depth_weights > 2.0 + FLT_EPSILON); // hack to avoid some of the haloing ( has side effects)
    //bool4 skip_probes = or(depth_weights < 0.0, depth_weights > 1.0); // This one causes artifacts from discarding too much stuff
    depth_weights = saturate(depth_weights);
        
    weights *= select(skip_probes, 0.0, 1.0); // does better with non-linear depths (and discarding everything < 0 or > 1
    
    
    weights /= hadd(weights); // normalize so total is 1 (as long as they're not all 0...)
    
    uint2 dir_offset = BilinearOffset(target_dir_index) + 2 * pos_in_target_probe;
    
    float4 upper_radiance = 0;
    
    for (uint p = 0; p < 4; p++)
    {
        uint2 upper_probe_id = upper_probe_tl + BilinearOffset(p);
        uint2 upper_probe_sample_texel = upper_probe_id * upper_probe_size + dir_offset;
        float4 upper_probe_radiance_min = g_lastCascade_min.Load(int3(upper_probe_sample_texel, 0));
        float4 upper_probe_radiance_max = g_lastCascade_max.Load(int3(upper_probe_sample_texel, 0));
        float4 max_radiance = upper_probe_radiance_max * weights[p];
        float4 min_radiance = upper_probe_radiance_min * weights[p];
        upper_radiance += lerp(min_radiance, max_radiance, depth_weights[p]); 
    }
    
    return MergeInterval(traced_radiance, upper_radiance);
}



// The primary kernel for the whole algorithm. Make other options behave like this too please
[numthreads(8, 8, 1 + (1 - MINMAX_LOOP))]
void TraceCascadesPreAvg4(uint3 did : SV_DispatchThreadID)
{
    // constants for this cascade
    const float cascade_index = g_cascadeId;
    const bool is_cascade_0 = cascade_index == 0;
    const bool is_max_cascade = g_cascadeId == g_numCascades;
    const float2 resolution = g_CascadeTexDimensions;
    const float2 one_over_res = 1.0 / resolution;
    
    #if RAYS_PER_PIXEL == 16
    const uint2 probe_size = pow(2, cascade_index); // size of the probe in pixels, c0 has 1x1 pixels / probe
    #elif RAYS_PER_PIXEL == 1
    const uint2 probe_size = pow(2, cascade_index + 2); // size of the probe in pixels, c0 has 4x4 pixels / probe
    #else
    const uint2 probe_size = pow(2, cascade_index + 1); // size of the probe in pixels, c0 has 2x2 pixels / probe                   // TODO: variable scaling factor for probe size per cascade
    #endif
    
    const float2 num_probes = resolution / probe_size; // [res/2, res/4, res/8, ...] number of probes in x/y direction (unused?)
    const float2 interval = GetInterval(cascade_index, g_c0_length); // the start and end distances of this cascade's interval
    
    // constants for this invocation (dependent on dispatch id)
    const uint2 coord = did.xy;
    if (any(coord > g_CascadeTexDimensions))
        return;
    // constants for this probe
    const uint2 probe_position = floor(coord / probe_size); // [0, num_probes] position of this probe in the grid of probes
    const float2 probe_center = (probe_position + 0.5) * probe_size; // [probe_size/2, res - probe_size/2] the texel coordinate of the center of this probe (basically just recreating coord and adding .5?)
    const float2 probe_center_uv = probe_center * one_over_res; // [0, 1] uv coordinate of this probe's center 
    // constants for this pixel
    const uint2 pos_in_probe = coord % probe_size; // [0, probe_size] position of this pixel in the probe
    
    // get probe normal and see if it's on a surface
    float3 probe_normal = g_GeometryNormalBuffer.SampleLevel(g_TextureSampler, probe_center_uv, 0).xyz;
    probe_normal = normalize(2.0 * probe_normal - 1.0); // using this to offset the position, still getting self intersections...?
 
    #if RAYS_PER_PIXEL == 16
    uint2 dir_counts = 4;
    #elif RAYS_PER_PIXEL == 1
    uint2 dir_counts = 1;
    #else
    uint2 dir_counts = 2;
    #endif
    
    // get ray origin for this probe 
    #if !MINMAX_MERGE
    #if PROBE_PLACEMENT == 0
    const float2 probe_depths = g_MinMaxDepth.SampleLevel(g_NearestSampler, probe_center_uv, cascade_index + 1 - g_resolution_factor).rg;
    const TwoPos origins = GetRayOriginDepthAware(probe_center_uv, probe_normal, probe_depths);
    const float3 origin = origins.near; // TODO: BUG: this gets us a bunch of stripes...? some resolution dependency with depth and probe textures, and weird self intersections. Depends on ray length??
    #elif PROBE_PLACEMENT == 1
    const float2 probe_depths = g_MinMaxDepth.SampleLevel(g_NearestSampler, probe_center_uv, 0).rg;
    const float3 origin = GetRayOrigin(probe_center_uv, probe_normal);
    #endif
    
    const bool is_sky_pixel = probe_depths.x == 1.0; //dot(probe_normal, probe_normal) == 0.0;
    if (is_sky_pixel)
    {
        o_currentCascade_min[coord] = float4(0, 0, 0, 1);
        return; // sky pixel does not reflect
    }
    
    
    float4 t_radiance = 0;
    [unroll]
    for (uint d = 0; d < RAYS_PER_PIXEL; d++) // Do 1, 4 or 16 rays this pixel
    {
        float3 direction = index_to_direction(d, dir_counts, pos_in_probe, probe_size);
        float4 curr_radiance = 0;
        #if DUMB_LEAKING_FIX
        TraceResult trace = (TraceResult)0;
        if (DumbLeakingFix_ShouldTrace(origin))
        {
            trace = TraceInterval(interval, origin, direction, is_max_cascade);
            curr_radiance = trace.radiance;
        }
        #else
        TraceResult trace = TraceInterval(interval, origin, direction, is_max_cascade);
        curr_radiance = trace.radiance;
        #endif
        
        #if LEAKING_FIX
        if(trace.hit_point.w == 0.0 && !is_max_cascade)
        {
            LeakingFix(curr_radiance, trace.hit_point.xyz, probe_position / 2, probe_size * 2, pos_in_probe, 0);
        }
        #endif
        
        float4 merged = curr_radiance;
        
        #if !DEBUG_DISABLE_MERGING
        if (!is_max_cascade) // merge
        {
            #if RAYS_PER_PIXEL == 16
            uint dir_index = (d / 4 + d / 2 - 3 * (d / 4 % 2) - 4 * (d / 8)); // holy fuck what is this mapping 0..16 -> 0,0,1,1,0,0,1,1,2,2,3,3,2,2,3,3
            #else
            uint dir_index = d;
            #endif
            merged = MergeUpperRadiance(curr_radiance, probe_position, probe_size, pos_in_probe, dir_index, probe_depths.r);
        }
        #else
        t_radiance += g_lastCascade_min[coord];
        #endif
        
        #if REVERSE_LEAKING_FIX
        if (!is_cascade_0)
        {
            ReverseLeakingFix(merged, origin + interval.x * direction, probe_position, pos_in_probe, probe_size, 0);
        }
        #endif
        
        t_radiance += merged;
    }
    if (is_cascade_0)
    {
        t_radiance *= (PI * 4.0 / (float)(probe_size.x * probe_size.y));
    }
    o_currentCascade_min[coord] = t_radiance * 1.0 / RAYS_PER_PIXEL;
    #else
    const float2 probe_depths = g_MinMaxDepth.SampleLevel(g_NearestSampler, probe_center_uv, cascade_index + 1 - g_resolution_factor).rg;
    const TwoPos origins = GetRayOriginDepthAware(probe_center_uv, probe_normal, probe_depths);
    const float3 probe_origins[2] = { origins.near, origins.far };
    #if MINMAX_LOOP
    [unroll]
    for (uint layer = 0; layer < 2; layer++)
    #else
    uint layer = did.z;
    #endif
    {
        float4 t_radiance = 0;
        [unroll]
        for (uint d = 0; d < RAYS_PER_PIXEL; d++)
        {
            float3 direction = index_to_direction(d, dir_counts, pos_in_probe, probe_size);
            #if DUMB_LEAKING_FIX
            TraceResult trace = (TraceResult)0;
            float4 curr_radiance = 0;
            if (DumbLeakingFix_ShouldTrace(probe_origins[0]))
            {
                trace = TraceInterval(interval, probe_origins[layer], direction, is_max_cascade);
                curr_radiance = trace.radiance;
            }
            #else
            TraceResult trace = TraceInterval(interval, probe_origins[layer], direction, is_max_cascade);
            float4 curr_radiance = trace.radiance;
            #endif            
    
            #if LEAKING_FIX
            if (trace.hit_point.w == 0.0 && !is_max_cascade)
            {
                LeakingFix(curr_radiance, trace.hit_point.xyz, probe_position / 2, probe_size * 2, 2 * pos_in_probe, layer);
            }
            #endif
            
            float4 merged = 0;
            if (!is_max_cascade) // merge
            {
                #if RAYS_PER_PIXEL == 16
                uint dir_index = (d / 4 + d / 2 - 3 * (d / 4 % 2) - 4 * (d / 8)); // holy fuck what is this mapping 0..16 -> 0,0,1,1,0,0,1,1,2,2,3,3,2,2,3,3
                #else
                uint dir_index = d;
                #endif
                merged = MinMaxMergeUpper(layer, curr_radiance, probe_position, probe_size, pos_in_probe, dir_index, probe_depths[layer]);
            }
            else
            {
                merged = curr_radiance;
            }
            
            #if REVERSE_LEAKING_FIX
            if(!is_cascade_0)
            {
                ReverseLeakingFix(merged, probe_origins[layer] + interval.x * direction, probe_position, pos_in_probe, probe_size, layer);
            }
            #endif
            
            t_radiance += merged;
        }
        if (is_cascade_0)
        {
            t_radiance *= (PI * 4.0 / (float)(probe_size.x * probe_size.y));
        }
        switch (layer)
        {
            case 1:{
                    o_currentCascade_max[coord] = t_radiance * 1.0 / RAYS_PER_PIXEL;
                    break;
                }
            case 0:
            default:{
                    o_currentCascade_min[coord] = t_radiance * 1.0 / RAYS_PER_PIXEL;
                    break;
                }
        }
        
    }
#endif

}


