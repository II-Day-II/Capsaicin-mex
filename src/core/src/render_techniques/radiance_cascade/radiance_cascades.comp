float4 MinMaxMergeUpper(uint layer, float4 traced_radiance, uint2 target_probe_pos, uint2 target_probe_size, uint2 pos_in_target_probe, uint target_dir_index, float target_probe_depth)
{
    const uint2 upper_probe_size = 2 * target_probe_size;
    const float2 one_over_res = 1.0 / float2(g_CascadeTexDimensions);
    uint2 upper_probe_tl;
    float4 weights;
    BilinearSamples(((target_probe_pos + 0.5) * target_probe_size), upper_probe_size, weights, upper_probe_tl);
    
    float4 upper_probe_depths[2] = { 0.xxxx, 0.xxxx };
    for (uint i = 0; i < 4; i++)
    {
        uint2 upper_probe_id = upper_probe_tl + BilinearOffset(i);
        float2 upper_probe_center_uv = (upper_probe_id + 0.5) * upper_probe_size * one_over_res; 
        float2 upper_depths = LinearizeDepth(g_MinMaxDepth.SampleLevel(g_NearestSampler, upper_probe_center_uv, g_cascadeId+2).rg); 
        upper_probe_depths[0][i] = upper_depths.r;
        upper_probe_depths[1][i] = upper_depths.g;
    }
    
    float maxd = dot(upper_probe_depths[1], 0.25.xxxx);
    float mind = dot(upper_probe_depths[0], 0.25.xxxx);
    float diffd = maxd - mind;
    float avg = (maxd + mind) * 0.5;
    bool d_edge = (diffd / avg) > 0.075;
    
    
    
    float4 depth_diffs = max(EPSILON, abs(upper_probe_depths[1] - upper_probe_depths[0]));
    float4 depth_weights = ((LinearizeDepth(target_probe_depth) - upper_probe_depths[0]) / depth_diffs);
    depth_weights = select(depth_weights > 1.0.xxxx, 0.0.xxxx, depth_weights);
    depth_weights = select(depth_weights < 0.0.xxxx, 0.0.xxxx, depth_weights);
    //depth_weights = saturate(depth_weights);
    
    if (d_edge)
    {
        float4 dd = depth_diffs;
        float4 edge_fn = EdgeFunction(dd);
        weights *= edge_fn;
    }
    weights /= hadd(weights); // normalize so total is 1
    
    uint2 dir_offset = BilinearOffset(target_dir_index) + 2 * pos_in_target_probe;
    
    float4 upper_radiance = 0;
    
    for (uint p = 0; p < 4; p++)
    {
        uint2 upper_probe_id = upper_probe_tl + BilinearOffset(p);
        uint2 upper_probe_sample_texel = upper_probe_id * upper_probe_size + dir_offset;
        float4 upper_probe_radiance_max = g_lastCascade_min.Load(int3(upper_probe_sample_texel, 0));
        float4 upper_probe_radiance_min = g_lastCascade_max.Load(int3(upper_probe_sample_texel, 0));
        float4 max_radiance = upper_probe_radiance_max * weights[p];
        float4 min_radiance = upper_probe_radiance_min * weights[p];
        upper_radiance += lerp(min_radiance, max_radiance, depth_weights[p]);
    }
    
    return MergeInterval(traced_radiance, upper_radiance);
}

float3 index_to_direction(uint d, uint2 dir_counts, uint2 pos_in_probe, uint2 probe_size)
{
    //const uint2 dir_counts = sqrt(dir_count_per_pixel);
    float2 dir_offset = index_to_uv_offset(d, dir_counts);
    // get a ray direction for this pixel in the probe
    //float2 uv_in_probe = (pos_in_probe + 0.5 + 0.5*(BilinearOffset(d) - 0.5)) / probe_size; // this works for d in [0,3]
    float2 uv_in_probe = (pos_in_probe + 0.5 + dir_offset) / probe_size;
        
#if SPHERE_MAP_MODE == 1
    float3 direction = octahedral_unmap(uv_in_probe); 
#elif SPHERE_MAP_MODE == 2
    float3 direction = oct_decode(uv_in_probe * 2.0 - 1.0); // this is an equal-area version of the above octahedral mapping. 
#else
    float3 direction = costheta_unmap(uv_in_probe); 
#endif
    return direction;
}


[numthreads(8,8,1)]
void TraceCascadesPreAvg4(uint3 did : SV_DispatchThreadID)
{
    // constants for this cascade
    const float cascade_index = g_cascadeId;
    const bool is_cascade_0 = cascade_index == 0;
    const bool is_max_cascade = g_cascadeId == g_numCascades;
    const float2 resolution = g_CascadeTexDimensions;
    const float2 one_over_res = 1.0 / resolution;
    const uint2 probe_size = pow(2, cascade_index+1); // size of the probe in pixels, c0 has 2x2 pixels / probe                   // TODO: variable scaling factor for probe size per cascade
    const float2 num_probes = resolution / probe_size; // [res/2, res/4, res/8, ...] number of probes in x/y direction (unused?)
    const float2 interval = GetInterval(cascade_index, g_c0_length); // the start and end distances of this cascade's interval                   // TODO: variable base length
    
    // constants for this invocation (dependent on dispatch id)
    const uint2 coord = did.xy;
    if (any(coord > g_CascadeTexDimensions))
        return;
    // constants for this probe
    const uint2 probe_position = floor(coord / probe_size); // [0, num_probes] position of this probe in the grid of probes
    const float2 probe_center = (probe_position + 0.5) * probe_size; // [probe_size/2, res - probe_size/2] the texel coordinate of the center of this probe (basically just recreating coord and adding .5?)
    const float2 probe_center_uv = probe_center * one_over_res; // [0, 1] uv coordinate of this probe's center 
    // constants for this pixel
    const uint2 pos_in_probe = coord % probe_size; // [0, probe_size] position of this pixel in the probe
    
    // get probe normal and see if it's on a surface
    float3 probe_normal = g_GeometryNormalBuffer.SampleLevel(g_TextureSampler, probe_center_uv, 0).xyz;
    //float3 probe_normal = g_GeometryNormalBuffer.SampleLevel(g_TextureSampler, coord * one_over_res, 0).xyz;
    const bool is_sky_pixel = dot(probe_normal, probe_normal) == 0.0;
    if (is_sky_pixel)
    {
        o_currentCascade_min[coord] = float4(0, 0, 0, 1);
        return; // sky pixel does not reflect
    }
    // get ray origin for this probe // TODO: different probes on min/max of depth buffer in this probe_position
    probe_normal = normalize(2.0 * probe_normal - 1.0); // using this to offset the position, still getting self intersections...?
    #if !MINMAX_MERGE
    #if PROBE_PLACEMENT == 0
    const float2 probe_depths = g_MinMaxDepth.SampleLevel(g_NearestSampler, probe_center_uv, cascade_index + 1).rg;
    const TwoPos origins = GetRayOriginDepthAware(probe_center_uv, probe_normal, probe_depths);
    const float3 origin = origins.near; // TODO: BUG: this gets us a bunch of stripes...? some resolution dependency with depth and probe textures, and weird self intersections. Depends on ray length??
    #elif PROBE_PLACEMENT == 1
    const float2 probe_depths = g_MinMaxDepth.SampleLevel(g_NearestSampler, probe_center_uv, 0).rg;
    const float3 origin = GetRayOrigin(probe_center_uv, probe_normal);
    #endif
    
    
    float4 t_radiance = 0;
    // Do 4 rays this pixel
    [unroll]
    for (uint d = 0; d < 4; d++)
    {
        float3 direction = index_to_direction(d, uint2(2, 2), pos_in_probe, probe_size);
        float4 curr_radiance = TraceInterval(interval, origin, direction, is_max_cascade);
        #if !DEBUG_DISABLE_MERGING
        if (!is_max_cascade) // merge
        {
            t_radiance += MergeUpperRadiance(curr_radiance, probe_position, probe_size, pos_in_probe, d, probe_depths.r);
        }
        else
        #else
        t_radiance += g_lastCascade_min[coord];
        #endif
        {
            t_radiance += curr_radiance;
        }
    }
    o_currentCascade_min[coord] = /*t_radiance.a != 0.0 && t_radiance.a != 1.0 ? float4(1,0,1,1) :*/ t_radiance * 0.25;
    #else
    const float2 probe_depths = g_MinMaxDepth.SampleLevel(g_NearestSampler, probe_center_uv, cascade_index + 1).rg;
    const TwoPos origins = GetRayOriginDepthAware(probe_center_uv, probe_normal, probe_depths);
    const float3 probe_origins[2] = { origins.near, origins.far };
    [unroll]
    for (uint layer = 0; layer < 2; layer++)
    {
        float4 t_radiance = 0;
        [unroll]
        for (uint d = 0; d < 4; d++)
        {
            float3 direction = index_to_direction(d, uint2(2, 2), pos_in_probe, probe_size);
            float4 curr_radiance = TraceInterval(interval, probe_origins[layer], direction, is_max_cascade);
            if (!is_max_cascade) // merge
            {
                t_radiance += MinMaxMergeUpper(layer, curr_radiance, probe_position, probe_size,  pos_in_probe, d, probe_depths[layer]);
            }
            else
            {
                t_radiance += curr_radiance;
            }
        }
        RWTexture2D<float4> output_tex = layer == 0 ? o_currentCascade_min : o_currentCascade_max;
        output_tex[coord] = t_radiance * 0.25;
    }
    #endif

}



// TODO: there's a lot of temporal noise and i dont know whyyyy ( it's maybe a sync issue)
[numthreads(8,8,1)]
void TraceCascadesPreAvg16(uint3 did : SV_DispatchThreadID) 
{
    //TraceCascadesPreAvg4(did);
    //return;
    // constants for this cascade
    const float cascade_index = g_cascadeId;
    const bool is_max_cascade = g_cascadeId == g_numCascades;
    //const float2 resolution = g_BufferDimensions; 
    const float2 resolution = g_CascadeTexDimensions;
    const float2 one_over_res = 1.0 / resolution;
    const uint2 probe_size = pow(2, cascade_index); // size of the probe in pixels, c0 has 1x1 pixels / probe                   // TODO: variable scaling factor for probe size per cascade
    const float2 num_probes = resolution / probe_size; // [res/2, res/4, res/8, ...] number of probes in x/y direction (unused?)
    const float2 interval = GetInterval(cascade_index, g_c0_length); // the start and end distances of this cascade's interval                   // TODO: variable base length
    
    // constants for this invocation (dependent on dispatch id)
    const uint2 coord = did.xy;
    if (any(coord > g_CascadeTexDimensions))
        return;
    // constants for this probe
    const uint2 probe_position = floor(coord / probe_size); // [0, num_probes] position of this probe in the grid of probes
    const float2 probe_center = (probe_position + 0.5) * probe_size; // [probe_size/2, res - probe_size/2] the texel coordinate of the center of this probe (basically just recreating coord and adding .5?)
    const float2 probe_center_uv = probe_center * one_over_res; // [0, 1] uv coordinate of this probe's center 
    // constants for this pixel
    const uint2 pos_in_probe = coord % probe_size; // [0, probe_size] position of this pixel in the probe
    
    // get probe normal and see if it's on a surface
    float3 probe_normal = g_GeometryNormalBuffer.SampleLevel(g_TextureSampler, probe_center_uv, 0).xyz;
    //float3 probe_normal = g_GeometryNormalBuffer.SampleLevel(g_TextureSampler, coord * one_over_res, 0).xyz;
    const bool is_sky_pixel = dot(probe_normal, probe_normal) == 0.0;
    if (is_sky_pixel)
    {
        o_currentCascade_min[coord] = float4(0, 0, 0, 1);
        return; // sky pixel does not reflect
    }
    // get ray origin for this probe // TODO: different probes on min/max of depth buffer in this probe_position
    probe_normal = normalize(2.0 * probe_normal - 1.0); // using this to offset the position, still getting self intersections...?
    #if PROBE_PLACEMENT == 0
    const float2 probe_depths = g_MinMaxDepth.SampleLevel(g_NearestSampler, probe_center_uv, g_cascadeId+1).rg;
    const float3 origin = GetRayOriginDepthAware(probe_center_uv, probe_normal, probe_depths).near; // BUG: this gets wacky stripes everywhere, dependent on ray length...?
    #elif PROBE_PLACEMENT == 1
    const float2 probe_depths= g_MinMaxDepth.SampleLevel(g_NearestSampler, probe_center_uv, 0).rg;
    const float3 origin = GetRayOrigin(probe_center_uv, probe_normal);
    #endif
    //const uint dir_count_per_pixel = 4*4; // should always be a square number i think (does it have to be an even square? a pow2 square?)
    const uint2 dir_counts = uint2(4, 4);
    const uint dir_count_per_pixel = dir_counts.x * dir_counts.y;
    
    float4 t_radiance = 0;
    [unroll]
    for (uint d = 0; d < dir_count_per_pixel; d++) // preaverage - trace 4 rays and store average result in this pixel
    {
        float3 direction = index_to_direction(d, dir_counts, pos_in_probe, probe_size);       
        // raytrace
        float4 curr_radiance = TraceInterval(interval, origin, direction, is_max_cascade);   
        #if !DEBUG_DISABLE_MERGING
        // merge
        if (!is_max_cascade) // merging
        {
            // TODO: how the hell do I generalize this for ranges other than 0..16???????
            uint mapped_d = (d / 4 + d / 2 - 3 * (d / 4 % 2) - 4 * (d / 8)); // holy fuck what is this mapping 0..16 -> 0,0,1,1,0,0,1,1,2,2,3,3,2,2,3,3
            //uint mapped_d = (d / (dir_count_per_pixel / 4)); // map d to 0..3 to choose corresponding ray average to merge with // TODO: variable scaling
            t_radiance += MergeUpperRadiance(curr_radiance, probe_position, probe_size, pos_in_probe, mapped_d, probe_depths.r);
        } // merging
        else // max cascade only needs curr_radiance
        #else
        t_radiance += g_lastCascade_min[coord];
        #endif
        {
            t_radiance += curr_radiance;
        }
    } // preaveraging 

    // return
    o_currentCascade_min[coord] = t_radiance / dir_count_per_pixel;
    //o_currentCascade_min[coord] = t_radiance / (t_radiance + 10.0);
    
}

