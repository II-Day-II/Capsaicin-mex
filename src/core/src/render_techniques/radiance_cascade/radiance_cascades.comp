Texture2D g_finalCascade_min;
Texture2D g_finalCascade_max;
RWTexture2D<float4> o_finalCascadeUpscaled_min;
RWTexture2D<float4> o_finalCascadeUpscaled_max;

[numthreads(8,8,1)]
void AverageFinalCascade(uint3 did : SV_DispatchThreadID) // averages each 2x2 probe in c0
{
    const uint2 coord = did.xy;
    const uint2 c0_probe_size = 2; 
    const uint2 probe_id = coord / c0_probe_size; // assuming 1 probe every 2 pixels in c0
    const uint2 read = probe_id * c0_probe_size;
    float4 total = 0;
    [unroll]
    for (uint y = 0; y < c0_probe_size.y; y++)
    {
        [unroll]
        for (uint x = 0; x < c0_probe_size.x; x++)
        {
            const uint2 pos = read + uint2(x, y);
            total += g_finalCascade_min.Load(int3(pos, 0));
        }
    }
    o_finalCascadeUpscaled_min[coord] = total / (c0_probe_size.x*c0_probe_size.y);
}
