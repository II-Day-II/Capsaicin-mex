// Cascade Layout
// Rows - depth angled rays
// Columns - projection angled rays
// ._______________________________.
// |   ↗   |   ↖   |   ↙   |   ↘   |
// |_______|_______|_______|_______|
// |   ↗   |   ↖   |   ↙   |   ↘   |
// |_______|_______|_______|_______|
// |   ↗   |   ↖   |   ↙   |   ↘   |
// |_______|_______|_______|_______|
// |   ↗   |   ↖   |   ↙   |   ↘   |
// |_______|_______|_______|_______|
// |_↗_|_↑_|_↖_|_←_|_↙_|_↓_|_↘_|_↗_|
// |_↗_|_↑_|_↖_|_←_|_↙_|_↓_|_↘_|_↗_|
// |_↗_|_↑_|_↖_|_←_|_↙_|_↓_|_↘_|_↗_|
// |_↗_|_↑_|_↖_|_←_|_↙_|_↓_|_↘_|_↗_|

// TODO: decipher this
float3 GetRay_DirectionFirst(float2 angleId, float cascadeLevel)
{
    float deltaAngle = TWO_PI * pow(0.5f, cascadeLevel) * 0.125f; // 1/8
    // Azimuth
    float phi = (angleId.x + 0.5f) * deltaAngle;
    // Polar
    float theta = lerp(0.4f, 0.6f, angleId.y * 0.33334f) * PI;

    float2 sinCosPhi;
    float2 sinCosTheta;
    sincos(phi, sinCosPhi.x, sinCosPhi.y);
    sincos(theta, sinCosTheta.x, sinCosTheta.y);

    return float3(sinCosTheta.x * sinCosPhi.y, sinCosTheta.y, sinCosTheta.x * sinCosPhi.x);
}

float GetProbeDepth(uint2 coord, uint cascade_level)
{
    //return g_Depth.Sample(g_samplerNearest, uv);
    return g_Depth.Load(int3(coord, cascade_level + 1)).r;
    //return g_Depth.SampleLevel(g_samplerNearest, uv, cascade_level + 1); // TODO: does this require Hi-Z?
}

float3 GetProbeNormal(uint2 coord)
{
    return g_GeometryNormalBuffer.Load(int3(coord, 0)).xyz;
}

float4 LoadUpperCascadeBilinear(uint2 coords, float2 weights)
{
    float4 a = o_CascadeTex[coords];
    float4 b = o_CascadeTex[coords + int2(1, 0)];
    float4 c = o_CascadeTex[coords + int2(0, 1)];
    float4 d = o_CascadeTex[coords + int2(1, 1)];

    float4 e = lerp(a, b, weights.x);
    float4 f = lerp(c, d, weights.x);

    return lerp(e, f, weights.y);
}

float4 LoadUpperRadiance(uint2 coords)
{
    const uint2 lowerCascadeSize = g_probesCount;
    const uint2 upperCascadeSize = g_probesCount * 0.5;
    uint2 upperCascadeCoords = floor(coords * 0.5);
    
    // TODO: decipher this shit
    uint2 lowerProbeId = coords % lowerCascadeSize;
    uint2 upperProbeBottomLeftId = clamp(floor((lowerProbeId - 1) * 0.5f), 0, upperCascadeSize - 2);
    float2 bilinearWeight = saturate(fmod((lowerProbeId - 1) * 0.5f, 1.0f) + 0.25f);
    
    upperCascadeCoords = upperCascadeCoords / upperCascadeSize * upperCascadeSize;
    upperCascadeCoords.x *= 2;
    upperCascadeCoords += upperProbeBottomLeftId;
    upperCascadeCoords.y += upperCascadeSize.y * 4;

    int2 offset = int2(upperCascadeSize.x, 0);

    float4 upperRadiance = 0.0f;

    // NOTE: Sample 2 main rays
    upperRadiance += LoadUpperCascadeBilinear(upperCascadeCoords, bilinearWeight);
    upperRadiance += LoadUpperCascadeBilinear(upperCascadeCoords + offset, bilinearWeight);
    
    return upperRadiance * 0.5; // ???
}

// TODO: figure out how I want to structure interval lengths
float2 GetInterval(uint cascade_index)
{
    const float factor = 1.0;
    float start = pow(2, cascade_index) * factor;
    float end = pow(2, cascade_index + 1) * factor;
    return float2(start, end);
}

float3 GetRayOrigin(float2 coord, float3 normal)
{
    float4 visibility = g_VisibilityBuffer.Load(int3(coord, 0));
    //return visibility.xyz;
    float2 barycentrics = visibility.xy;
    uint instanceID = asuint(visibility.z);
    uint primitiveID = asuint(visibility.w);

    Instance instance = g_InstanceBuffer[instanceID];
    Mesh mesh = g_MeshBuffer[instance.mesh_index];
    float3x4 transform = g_TransformBuffer[instance.transform_index];

    Triangle vertices = fetchVertices(mesh, primitiveID);
    float3 v0 = transformPoint(vertices.v0, transform);
    float3 v1 = transformPoint(vertices.v1, transform);
    float3 v2 = transformPoint(vertices.v2, transform);

    float3 world = interpolate(v0, v1, v2, barycentrics);
    float3 origin = offsetPosition(world, normal);
    return origin;
}

RayDesc GetRay(uint2 probeCenterCoord, float2 angleId, float3 probeNormal, uint cascade_index)
{
    RayDesc ray_desc;
    float2 interval = GetInterval(cascade_index);
    ray_desc.TMin = interval.x;
    ray_desc.TMax = interval.y;
    ray_desc.Direction = GetRay_DirectionFirst(angleId, cascade_index);
    ray_desc.Origin = GetRayOrigin(probeCenterCoord, probeNormal);
    return ray_desc;
}

float4 GetRadiance(IntersectData idata)
{
    return float4(idata.position, 1.0);

}


