float LinearizeDepth(float depth)
{
    const float near = g_near; 
    const float far = g_far; 
    float ndcz = 2.0 * depth - 1.0;
    return (2.0 * near * far) / (far + near - ndcz * (far - near));
}

float2 LinearizeDepth(float2 depth)
{
    const float near = g_near;
    const float far = g_far;
    float2 ndcz = 2.0 * depth - 1.0;
    return (2.0 * near * far) / (far + near - ndcz * (far - near));
}

float4 LinearizeDepth(float4 depth)
{
    const float near = g_near;
    const float far = g_far;
    float4 ndcz = 2.0 * depth - 1.0;
    return (2.0 * near * far) / (far + near - ndcz * (far - near));
}

float IntervalScale(uint cascade_index)
{
    if (cascade_index == 0)
        return 0.0;
    else if (cascade_index > g_numCascades) // the top cascade should end as far away as possible if it integrates the skybox
        return FLT_MAX;
    //return pow(2.0, cascade_index);
    return float(1u << (2u * cascade_index)); // TODO: variable scale factor here, currently equiv. pow(4, idx) (4 recommended by Sannikov)
}

// NOTE: Interval lengths. They must be long enough to reach opposing walls, but short enough to not be noticeable at close distances
float2 GetInterval(uint cascade_index, float base_length)
{
    return base_length * float2(IntervalScale(cascade_index), IntervalScale(cascade_index + 1) + 1);
    //length(pow(2.0.xx, 0 /*cascade_index*/))); // a little bit of interval overlap, as a treat
}


float4 BilinearWeights(float2 ratio)
{
    float4 bw = float4(ratio, 1.0 - ratio);
    return bw.zxzx * bw.wwyy;
    //return float4(
    //      (1.0 - ratio.x) * (1.0 - ratio.y)
    //    , ratio.x * (1.0 - ratio.y)
    //    , (1.0 - ratio.x) * ratio.y
    //    , ratio.x * ratio.y
    //);
}

/*
@param dest_center the center position of the destination probe in pixels [probe_size/2, res - probe_size/2]
@param upper_probe_size the size of the bilinear probe in pixels [probe_size*2]
source: <https://m4xc.dev/articles/fundamental-rc/>
*/
void BilinearSamples(float2 dest_center, float2 upper_probe_size, out float4 weights, out uint2 base_idx)
{
    // coord of top left bilinear probe when floored
    const float2 base_coord = (dest_center / upper_probe_size) - float2(0.5, 0.5);
    const float2 ratio = frac(base_coord); // sub-bilinear probe pos
    weights = BilinearWeights(ratio);
    base_idx = uint2(floor(base_coord)); // top left upper probe id in upper probe grid
}

uint2 BilinearOffset(uint i)
{
    const uint2 offsets[4] = { uint2(0, 0), uint2(1, 0), uint2(0, 1), uint2(1, 1) };
    return offsets[i];
}

