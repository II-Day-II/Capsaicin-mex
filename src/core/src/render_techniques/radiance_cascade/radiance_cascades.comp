    float depth = min_max_depth.r;
    
    float4x4 transform = g_ViewProjectionInverse;
    float3 scaled_normal = normal * g_depth_bias_scale;// 34.5; // wtf is this (avoid self intersections) (34.5 is minimum for sponza??)
    
