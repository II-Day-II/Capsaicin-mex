    float3 world_max = transformPointProjection(float3(2.0f.xx * float2(probe_uv.x, 1.0f - probe_uv.y) - 1.0f.xx, depth), transform); 
    float3 origin_max = offsetPosition(world_max, scaled_normal);
    TwoPos ret = {origin_min, origin_max};
    return ret;
#endif
    //return transformPointProjection(float3(2.0f * float2(probe_uv.x, 1.0f - probe_uv.y) - 1.0f, depth), transform) + normal * 1.0/32.0; // this seems safer than the admittedly cool offsetPosition(), but it's way more noticeable.
    //return transformPointProjection(float3(2.0f * float2(probe_uv.x, 1.0f - probe_uv.y) - 1.0f, depth), transform);
}

float3 GetRayOrigin(float2 probe_uv, float3 normal)
{
    float4 visibility = g_VisibilityBuffer.SampleLevel(g_NearestSampler, probe_uv, 0);

    float2 barycentrics = visibility.xy;
    uint instanceID = asuint(visibility.z);
    uint primitiveID = asuint(visibility.w);

    Instance instance = g_InstanceBuffer[instanceID];
    Mesh mesh = g_MeshBuffer[instance.mesh_index];
    float3x4 transform = g_TransformBuffer[instance.transform_index];

    Triangle vertices = fetchVertices(mesh, primitiveID);
    float3 v0 = transformPoint(vertices.v0, transform);
    float3 v1 = transformPoint(vertices.v1, transform);
    float3 v2 = transformPoint(vertices.v2, transform);

    float3 world = interpolate(v0, v1, v2, barycentrics);
    float3 origin = offsetPosition(world, normal);
    return origin;
}

