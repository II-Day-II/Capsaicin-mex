// idx: [0, sample_counts.x*sample_counts.y]
// sample_counts: sqrt(rays per pixel)
// 
float2 index_to_uv_offset(uint idx, uint2 sample_counts) 
{
    float2 sample_idx = float2(idx % sample_counts.x, idx / sample_counts.x) + 0.5; // [0.5,sample_counts-0.5] eg [0.5, 3.5] for sc=4,4
    sample_idx = sample_idx - 0.5 * float2(sample_counts); // [-sample_counts/2+0.5, sample_count/2-0.5] eg [-1.5,1.5] for sc=4,4
    return sample_idx / sample_counts; //[-0.5+0.5/sample_counts, 0.5-0.5/sample_counts] eg [-3/8, 3/8] for sc=4,4
}

float4 MergeInterval(float4 near, float4 far)
{
    const float3 radiance = near.rgb + (far.rgb * near.a);
    return float4(radiance, near.a * far.a);
}

float4 TraceInterval(float2 interval, float3 origin, float3 direction, bool is_max_cascade)
{
    float4 curr_radiance = float4(0.0, 0.0, 0.0, 1.0);
    
#if DEBUG_DIRECTIONS
        curr_radiance = float4(direction, 1.0);
#else
    RayDesc ray;
    ray.Direction = direction;
    ray.Origin = origin;
    ray.TMin = interval.x;
    ray.TMax = interval.y;
        
    // TODO: BUG: there's a bunch of light leaking with long ray intervals...
    
    ClosestRayQuery query = TraceRay < ClosestRayQuery > (ray);
    if (query.CommittedStatus() != COMMITTED_NOTHING) // ray hit something
    {
        float t = query.CommittedRayT();
        HitInfo hit = GetHitInfoRtInlineCommitted(query);
        if (hit.frontFace)
        {
            IntersectData idata = MakeIntersectData(hit); // TODO: sample lights the correct way, if bounce lighting is even possible
            curr_radiance.rgb = GetRadiance(idata, ray).rgb * 1;
            //curr_radiance.rgb = ray.Direction;
            curr_radiance.a = 0.0; // occluded
        }
        else
        {
            curr_radiance.a = 0;
        }
    }
    else if (is_max_cascade) // hit nothing, sample env. map if top cascade 
    {
#if DEBUG_DISABLE_ENV_MAP
        curr_radiance.rgb = 0;
#else
        curr_radiance.rgb = g_EnvironmentBuffer.SampleLevel(g_TextureSampler, ray.Direction, 0.0).rgb * 1.0;
#endif
        curr_radiance.a = 0; // this prevents propagating cMax sky samples when lower cascades' partially occluded ray groups merge with cMax
    }
#endif
    // this is the hackest hack i've ever done
//    if (direction.z == 0)
//    {
//        curr_radiance.a = 0; // axis aligned ray will never hit axis aligned wall
//    }
    return curr_radiance;
}

float4 EdgeFunction(float4 depth_diffs)
{
    //return exp(-100 * depth_diffs);
    return (1.0 / (1e4 * depth_diffs + 1));
}

