[numthreads(8,8,1)]
void PingPongCascades(uint3 did : SV_DispatchThreadID)
{
    const uint2 coord = did.xy;
    const float base = 4.0; // TODO: redo this, maybe use probe count instead?
    const float sqrt_base = sqrt(base);
    const float cascade_index = g_cascadeId;
    const float2 resolution = g_CascadeTexDimensions;
    const float2 one_over_res = 1.0 / resolution;
    const float shortest_side = min(resolution.x, resolution.y);
    const float2 aspect = shortest_side * one_over_res;
    const bool is_cascade_0 = g_cascadeId == 0;
    float spacing = pow(sqrt_base, cascade_index); // spacing between probes 
    uint2 num_probes = floor(resolution / spacing); // number of probes in x/y directions
    uint2 probe_rel_pos = coord % num_probes; // [0, res/spacing] position of the pixel in the probe we're doing this pass
    uint2 ray_pos = coord / num_probes; // [0, num_probes] ray id of this pass - which direction will we be tracing?
    uint base_idx = base * (ray_pos.x + spacing * ray_pos.y);
    float2 probe_center = (probe_rel_pos + 0.5) * spacing; // [0, resolution]
    float2 probe_center_uv = probe_center * one_over_res; // [0, 1]
    
    //o_currentCascade[did.xy] = float4(probe_center_uv, 0, 1);
    //return;
    
    float3 direction = mapToHemiOctahedronInverse(probe_center_uv); // +hemisphere ray direction. Now to rotate the direction according to normal...
    float3 normal = 2.0 * g_GeometryNormalBuffer.Load(int3(probe_center_uv * g_BufferDimensions, 0)).xyz - 1.0;
    
    //o_currentCascade[did.xy] = float4(normal, 1);
    //return;
    
    bool is_sky_pixel = dot(normal, normal) == 0.0;
    if (is_sky_pixel)
    {
        o_currentCascade[did.xy] = float4(0, 0, 0, 1);
        return; // sky pixel
    }
    RayDesc ray = GetRay(probe_center, probe_center, normal, cascade_index);
    
    //o_currentCascade[did.xy] = float4(direction, 1);
    //return;
    
    float3 b1, b2;
    GetOrthoVectors(normal, b1, b2);
    direction = direction.x * b1 + direction.y * b2 + direction.z * normal;
    
     // TODO: figure out rays 
    ClosestRayQuery query = TraceRay<ClosestRayQuery>(ray);
    
    float4 radiance = float4(0.0, 0.0, 0.0, 1.0);
    
    if (query.CommittedStatus() == COMMITTED_TRIANGLE_HIT) // ray hit something
    {
        float t = query.CommittedRayT();
        HitInfo hit = GetHitInfoRtInlineCommitted(query);
        IntersectData idata = MakeIntersectData(hit);
        // TODO: get radiance from hit surface
        radiance.rgb = GetRadiance(idata).rgb;
        radiance.a = 0.0; // occluded
    }
    else // hit nothing
    {
        // TODO: sample env. map
        radiance = float4(2, 2, 2, 1);
    }
    
    if (!is_cascade_0)
    {
        float upper_spacing = pow(sqrt_base, cascade_index + 1);
        float2 upper_probe_count = floor(resolution / upper_spacing);
        float2 upper_pos = float2(fmod(base_idx, upper_spacing), floor(base_idx / upper_spacing)) * upper_probe_count;
        
        float2 offset = (probe_rel_pos + 0.5) / sqrt_base;
        float2 clamped = clamp(offset, 0.5.xx, upper_probe_count - 0.5);
        float4 upperRadiance = g_lastCascade.Load(int3(clamped, 0)); // TODO: Depth aware upscaling...
        radiance.rgb += upperRadiance.rgb * radiance.a;
        radiance.a *= upperRadiance.a;
    }
    o_CascadeTex[did.xy] = radiance;
    return;
    
}


[numthreads(8,4,1)]
void RenderCascades(uint3 did : SV_DispatchThreadID)
{
    // TODO: rearrange how we store this
    int2 coords = int2(did.xy);
    //if (true)
    //{ float2 uv = float2(coords) / float2(g_BufferDimensions); o_CascadeTex[coords] = float4(uv, 0.025, 1.0); return; }
    
    // TODO: place probes on min/max depth of each probe size area of buffer; figure out how to store and merge that
    
    
    int2 targetCoords = coords + int2(0, 4 * g_probesCount.y);
    if (coords.x >= g_BufferDimensions.x || coords.y >= 4 * g_probesCount.y)
    {
        return; // Out of bounds
    }
    int2 probeCenterCoord = coords % g_probesCount;
    float2 probeCenterUV = float2(probeCenterCoord + 1) / float2(g_probesCount + 1);
    int2 probeCenterTexelSpace = probeCenterUV * g_BufferDimensions;
    
    const float cascadeLevel = float(g_cascadeId);
    
    const float cascadeFactor = pow(2.0, cascadeLevel);
    const float projRays = 8.0 * cascadeFactor;
    const float depthRays = floor(4.0 * 2.0 * cascadeFactor);
    float2 angleId = float2(floor(coords.x * projRays / float(g_BufferDimensions.x)), fmod(floor(1.0 - (coords.y + 1.0) / float(g_BufferDimensions.y)) * depthRays, 4.0));
    
    float probeDepth = GetProbeDepth(probeCenterTexelSpace, cascadeLevel);
    float3 probeNormal = GetProbeNormal(probeCenterTexelSpace);
    bool is_sky_pixel = dot(probeNormal, probeNormal) == 0.0f;
    
    //if (false)
    if (is_sky_pixel)
    {
        o_CascadeTex[targetCoords] = float4(0.0, 0.0, 0.0, 1.0);
        return;
    }
    
    // trace some rays
    RayDesc ray = GetRay(probeCenterTexelSpace, probeDepth, probeNormal, g_cascadeId);
    // TODO: figure out rays 
    ClosestRayQuery query = TraceRay<ClosestRayQuery>(ray);
    
    float4 radiance = float4(0.0, 0.0, 0.0, 1.0);
    
    if (query.CommittedStatus() == COMMITTED_TRIANGLE_HIT) // ray hit something
    {
        float t = query.CommittedRayT();
        HitInfo hit = GetHitInfoRtInlineCommitted(query);
        IntersectData idata = MakeIntersectData(hit);
        // TODO: get radiance from hit surface
        radiance.rgb = GetRadiance(idata).rgb;
        radiance.a = 0.0; // occluded
        if(g_cascadeId < 4) // not final one
        {
            o_CascadeTex[targetCoords] = radiance;
            return;
        }
        float4 upperRadiance = LoadUpperRadiance(coords);
        radiance.rgb += upperRadiance.rgb * radiance.a;
        radiance.a *= upperRadiance.a;
        o_CascadeTex[targetCoords] = radiance;
        //o_CascadeTex[targetCoords] = float4(t, idata.uv, 1.0);
        return;
    }
    else // hit nothing
    {
        // TODO: sample env. map
        o_CascadeTex[targetCoords] = float4(2, 2, 2, 1);
    }
    
}

RWTexture2D<float4> o_IntermediateCascade;

[numthreads(8,8,1)]
void MergeCascades(uint3 did : SV_DispatchThreadID)
{
    // TODO: wtf is all this
    uint2 targetCoords = did.xy;
    float4 texSizes = float4(g_BufferDimensions.xy, 1.0 / g_BufferDimensions.xy);
    
    float2 sideId = floor(2 * did.xy * texSizes.zw);
    float side = sideId.x + sideId.y * 2;
    uint2 coords = fmod(did.xy * 2, texSizes.xy) * 0.25;
    coords.y += 7.0 * 0.125 * texSizes.y;
    coords.x += side * texSizes.x * 0.25;
    float2 weight = max(0.0, frac(did.xy * 0.25) - 0.25);
    int2 offset = int2(0, -texSizes.y * 0.125);
    float2 uv = frac(2.0 * texSizes.zw * did.xy);
    //float3 normal = g_GeometryNormalBuffer.Sample(g_TextureSampler, uv).xyz; // ???
    float3 normal = g_GeometryNormalBuffer.Load(int3(uv * texSizes.xy, 0)).xyz;
    float4 radiance = 0.0;
    uint2 c = coords;
    for (uint i = 0; i < 4; i++)
    {
        float2 angleId = float2(side * 2.0, i);
        float3 dir = GetRay_DirectionFirst(angleId, 0);
        radiance += LoadUpperCascadeBilinear(c, weight) * saturate(dot(dir, normal));
        c.y += offset.y;
    }
    c = coords + uint2(texSizes.x * 0.125, 0);
    for (uint ii = 0; ii < 4; ii++)
    {
        float2 angleId = float2(side * 2 + 1, ii);
        float3 dir = GetRay_DirectionFirst(angleId, 0);
        radiance += LoadUpperCascadeBilinear(c, weight) * saturate(dot(dir, normal));
        c.y += offset.y;
    }
    o_IntermediateCascade[targetCoords] = radiance * 0.5;
}

//RWTexture2D<float4> o_IntermediateCascade2;
RWTexture2D<float4> o_FinalCascade;

[numthreads(8,8,1)]
void AintNoWayINeedAnotherPass(uint3 did : SV_DispatchThreadID)
{
    // fucking do it again lmao???
    float3 normal_ = g_GeometryNormalBuffer.Load(int3(did.xy, 0)).xyz;
    float4 color = 0.0;
    for (uint x = 0; x < 8; x++)
    {
        for (uint y = 0; y < 4; y++)
        {
            float3 dir = GetRay_DirectionFirst(float2(x, y), 0);
            float NdotL = saturate(dot(normal_, dir));
            float4 radiance = o_IntermediateCascade[did.xy + uint2(x, -y) * g_BufferDimensions.xy * 0.125];
            color += radiance * NdotL;
        }
    }
    o_FinalCascade[did.xy] = color;
    return;
}


[numthreads(8,8,1)]
void FinalPassForReal(uint3 did: SV_DispatchThreadID)
{
    float4 texSizes = float4(g_BufferDimensions.xy, 1.0 / g_BufferDimensions.xy);
    int3 cascadeSizeOffset = int3(round(0.5 * texSizes.zw), 0);
    int2 coords = floor(did.xy * 0.5);
    float4 r = o_IntermediateCascade[coords];
    r += o_IntermediateCascade[coords + cascadeSizeOffset.xz];
    r += o_IntermediateCascade[coords + cascadeSizeOffset.zy];
    r += o_IntermediateCascade[coords + cascadeSizeOffset.xy];
    o_FinalCascade[did.xy] = r;
}

