// rc uniforms
uint g_cascadeId;
uint2 g_BufferDimensions;

float GetProbeDepth(uint2 coord, uint cascade_level)
{
    //return g_Depth.Sample(g_samplerNearest, uv);
    return g_Depth.Load(int3(coord, cascade_level + 1)).r;
    //return g_Depth.SampleLevel(g_samplerNearest, uv, cascade_level + 1); // TODO: does this require Hi-Z?
}

float3 GetProbeNormal(uint2 coord)
{
    return g_GeometryNormalBuffer.Load(int3(coord, 0)).xyz;
}

float IntervalScale(uint cascade_index)
{
    if (cascade_index == 0)
        return 0.0;
    return pow(2.0, cascade_index);
    return float(1u << (1u * cascade_index));
}

// TODO: figure out how I want to structure interval lengths
float2 GetInterval(uint cascade_index, float base_length)
{
    return base_length * float2(IntervalScale(cascade_index), IntervalScale(cascade_index + 1));
}

float4 MergeInterval(float4 near, float4 far)
{
    const float3 radiance = near.rgb + (far.rgb * near.a);
    return float4(radiance, near.a * far.a);
}

float4 BilinearWeights(float2 ratio)
{
    return float4(
          (1.0 - ratio.x) * (1.0 - ratio.y)
        , ratio.x * (1.0 - ratio.y)
        , (1.0 - ratio.x) * ratio.y
        , ratio.x * ratio.y
    );
}

/*
@param dest_center the center position of the destination probe in pixels
@param bilinear_size the size of the bilinear probe in pixels
*/
void BilinearSamples(float2 dest_center, float2 bilinear_size, out float4 weights, out uint2 base_idx)
{
    // coord of top left bilinear probe when floored
    const float2 base_coord = (dest_center / bilinear_size) - float2(0.5, 0.5);
    const float2 ratio = frac(base_coord); // sub-bilinear probe pos
    weights = BilinearWeights(ratio);
    base_idx = uint2(floor(base_coord)); // top left bilinear probe coordinate
}

uint2 BilinearOffset(uint i)
{
    const uint2 offsets[4] = { uint2(0, 0), uint2(1, 0), uint2(0, 1), uint2(1, 1) };
    return offsets[i];
}


float3 GetRayOrigin(float2 coord, float3 normal)
{
    float4 visibility = g_VisibilityBuffer.Load(int3(coord, 0));

    float2 barycentrics = visibility.xy;
    uint instanceID = asuint(visibility.z);
    uint primitiveID = asuint(visibility.w);

    Instance instance = g_InstanceBuffer[instanceID];
    Mesh mesh = g_MeshBuffer[instance.mesh_index];
    float3x4 transform = g_TransformBuffer[instance.transform_index];

    Triangle vertices = fetchVertices(mesh, primitiveID);
    float3 v0 = transformPoint(vertices.v0, transform);
    float3 v1 = transformPoint(vertices.v1, transform);
    float3 v2 = transformPoint(vertices.v2, transform);

    float3 world = interpolate(v0, v1, v2, barycentrics);
    float3 origin = offsetPosition(world, normal);
    return origin;
}

float4 GetRadiance(IntersectData idata, RayDesc ray)
{
    //return float4(idata.normal, 1.0);
    Material material = idata.material;
    MaterialBRDF materialBRDF = MakeMaterialBRDF(material, idata.uv);
    float3 reflectance = evaluateBRDF(materialBRDF, idata.normal, ray.Direction, normalize(float3(1, 1, 1)));
    return float4(reflectance, 1);
}


#define DEBUG_DIRECTIONS 0
#define DEBUG_DISABLE_MERGING 0

Texture2D g_lastCascade;
RWTexture2D<float4> o_currentCascade;
uint2 g_CascadeTexDimensions;


[numthreads(8,8,1)]
void TraceCascades(uint3 did : SV_DispatchThreadID)
{
    // constants for this cascade
    const float cascade_index = g_cascadeId;
    const bool is_cascade_0 = cascade_index == 0;
    const float2 resolution = g_BufferDimensions; // g_CascadeTexDimensions;
    const float2 one_over_res = 1.0 / resolution;
    const float2 probe_size = pow(2, cascade_index + 1);             // size of the probe in pixels, c0 has 2x2 pixels / probe // TODO: variable scaling factor for probe size per cascade
    const float2 num_probes = resolution / probe_size;               // [res/2, res/4, res/8, ...] number of probes in x/y direction (unused?)
    const float2 interval = GetInterval(cascade_index, 1.0);         // the start and end distances of this cascade's interval // TODO: variable base length
    
    // constants for this invocation (dependent on dispatch id)
    const uint2 coord = did.xy;
    // constants for this probe
    const float2 probe_position = floor(coord / probe_size);         // [0, num_probes] position of this probe in the grid of probes
    const float2 probe_center = (probe_position + 0.5) * probe_size; // [probe_size/2, res - probe_size/2] the texel coordinate of the center of this probe
    const float2 probe_center_uv = probe_center * one_over_res;      // [0, 1] uv coordinate of this probe's center
    // constants for this pixel
    const float2 pos_in_probe = coord % probe_size;                  // [0, probe_size] position of this pixel in the probe

    // get probe normal and see if it's on a surface
    float3 probe_normal = g_GeometryNormalBuffer.SampleLevel(g_TextureSampler, probe_center_uv, 0);
    const bool is_sky_pixel = dot(probe_normal, probe_normal) == 0.0;
    if(is_sky_pixel)
    {
        o_currentCascade[coord] = float4(0, 0, 0, 1);
        return; // sky pixel does not reflect
    }
    probe_normal = 2.0 * probe_normal - 1.0;
    // get ray origin for this probe // TODO: different probes on min/max of depth buffer in this probe_position
    const float3 origin = GetRayOrigin(probe_center, probe_normal);
    
    // get a ray direction for this pixel in the probe
    const float2 uv_in_probe = (pos_in_probe / probe_size) + 0.5;
    float3 direction = mapToHemiOctahedronInverse(uv_in_probe);
    // TODO: rotate direction to align with probe normal
    float3 b1, b2;
    GetOrthoVectors(probe_normal, b1, b2);
    direction = direction.x * b1 + direction.y * b2 + direction.z * probe_normal;
    
    // TODO: Do I need to do preaveraging (4 rays per pixel)?
    
    // raytrace
    float4 radiance = float4(0.0, 0.0, 0.0, 1.0);
    
    #if DEBUG_DIRECTIONS
    radiance = float4(direction, 1.0);
    #else
    RayDesc ray;
    ray.Direction = direction;
    ray.Origin = origin;
    ray.TMin = interval.x;
    ray.TMax = interval.y;
    
    ClosestRayQuery query = TraceRay<ClosestRayQuery>(ray);
    if (query.CommittedStatus() == COMMITTED_TRIANGLE_HIT) // ray hit something
    {
        float t = query.CommittedRayT();
        HitInfo hit = GetHitInfoRtInlineCommitted(query);
        IntersectData idata = MakeIntersectData(hit);
        radiance.rgb = GetRadiance(idata, ray).rgb;
        radiance.a = 0.0; // occluded
    }
    else // hit nothing, sample environment map
    {
        radiance = g_EnvironmentBuffer.SampleLevel(g_TextureSampler, ray.Direction, 0.0);
    }
    #endif
    
    #if !DEBUG_DISABLE_MERGING
    // merge with upper cascade
    float2 bilinear_size = pow(2, cascade_index + 2);
    float4 weights;
    uint2 top_left_bilin_probe_coord;
    BilinearSamples(probe_center, bilinear_size, weights, top_left_bilin_probe_coord);
    float4 bilinear_radiance = 0;
    for (uint i = 0; i < 4; i++)
    {
        float2 offset = BilinearOffset(i);
        float2 bilinear_idx = top_left_bilin_probe_coord + offset;
        float2 bilinear_texel = bilinear_idx * bilinear_size;
        float4 bilinear_interval = g_lastCascade.Load(int3(bilinear_texel, 0));
        bilinear_radiance += bilinear_interval * weights[i];
    }
    
    radiance = MergeInterval(radiance, bilinear_radiance);
    #endif
    
    // return
    o_currentCascade[coord] = radiance;
}
