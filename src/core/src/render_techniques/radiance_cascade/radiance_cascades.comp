TwoPos GetRayOriginDepthAware(float2 probe_uv, float3 normal, float2 probe_depths)
{
    float2 min_max_depth = probe_depths;
    float depth = min_max_depth.r;
    
    float4x4 transform = g_ViewProjectionInverse;
    float3 scaled_normal = normal * 1;// 34.5; // wtf is this (avoid self intersections) (34.5 is minimum for sponza??)
    float3 world_min = transformPointProjection(float3(2.0f.xx * float2(probe_uv.x, 1.0f - probe_uv.y) - 1.0f.xx, depth), transform);
    float3 origin_min = offsetPosition(world_min, scaled_normal);
    depth = min_max_depth.g;
    float3 world_max = transformPointProjection(float3(2.0f.xx * float2(probe_uv.x, 1.0f - probe_uv.y) - 1.0f.xx, depth), transform); 
    float3 origin_max = offsetPosition(world_max, scaled_normal);
    TwoPos ret = {origin_min, origin_max};
    return ret;
    //return transformPointProjection(float3(2.0f * float2(probe_uv.x, 1.0f - probe_uv.y) - 1.0f, depth), transform) + normal * 1.0/32.0; // this seems safer than the admittedly cool offsetPosition(), but it's way more noticeable.
    //return transformPointProjection(float3(2.0f * float2(probe_uv.x, 1.0f - probe_uv.y) - 1.0f, depth), transform);
}

float3 GetRayOrigin(float2 probe_uv, float3 normal)
{
    float4 visibility = g_VisibilityBuffer.SampleLevel(g_NearestSampler, probe_uv, 0);

    float2 barycentrics = visibility.xy;
    uint instanceID = asuint(visibility.z);
    uint primitiveID = asuint(visibility.w);

    Instance instance = g_InstanceBuffer[instanceID];
    Mesh mesh = g_MeshBuffer[instance.mesh_index];
    float3x4 transform = g_TransformBuffer[instance.transform_index];

    Triangle vertices = fetchVertices(mesh, primitiveID);
    float3 v0 = transformPoint(vertices.v0, transform);
    float3 v1 = transformPoint(vertices.v1, transform);
    float3 v2 = transformPoint(vertices.v2, transform);

    float3 world = interpolate(v0, v1, v2, barycentrics);
    float3 origin = offsetPosition(world, normal);
    return origin;
}

float4 GetRadiance(IntersectData idata, RayDesc ray)
{
    //return float4(idata.normal, 1.0);
    Material material = idata.material;
    MaterialBSDF materialBSDF = MakeMaterialBSDF(material, idata.uv);
    float3 reflectance = 0;
    if (dot(materialBSDF.emissive, materialBSDF.emissive) == 0)
    {
        // TODO: sample a light in some reasonable way (use the gi10 hashgrid cache?)
        // TODO: account for whether the light is occluded as well (we have no shadow maps QmQ)
        // TODO: should we even look at direct lighting here? Seems stupid
        MaterialBRDF materialBRDF = MakeMaterialBRDF(material, idata.uv);
        // compute diffuse compensation term with specular dominant half-vector
        float3 specular_dominant_direction = calculateGGXSpecularDirection(idata.normal, ray.Direction, sqrt(materialBRDF.roughnessAlpha));
        float3 specular_dominant_half_vector = normalize(ray.Direction + specular_dominant_direction);
        float dotHV = saturate(dot(ray.Direction, specular_dominant_half_vector));
        float3 diffuse_compensation = diffuseCompensation(materialBRDF.F0, dotHV);

        // diffuse term
        float3 diffuse = evaluateLambert(materialBRDF.albedo) * diffuse_compensation * 0.05; // TODO: wtf am i even trying to do here
        //float3 closest_light_dir = float3(0,0,0);
        //reflectance = evaluateBRDF(materialBRDF, idata.normal, ray.Direction, normalize(closest_light_dir)); 
        reflectance = diffuse;
        reflectance = 0;
    }
    else
    {
        reflectance = materialBSDF.emissive * 1;
    }
    return float4(reflectance, 1);
}

/*- direction mapping: 
 *  source <https://www.shadertoy.com/view/4cjczV> -*/
#define MIRROR 0

float3 octahedral_unmap(float2 e)
{
#if MIRROR
    /* Source: <https://www.shadertoy.com/view/MdsfzN> */
    float2 m = abs(e - 0.5) + 0.5;
    float2 f = floor(m);
    float x = f.x - f.y;
    bool mirror = (x != 0.0); 
    if (mirror) e.xy = 1.0-e.xy;
#endif
    /* Provided by Alexander Sannikov */
    e = frac(e);
    e = e * 2.0 - 1.0;
    float3 v = float3(e.xy, 1.0 - abs(e.x) - abs(e.y));
    if (v.z < 0.0)
        v.xy = (1.0 - abs(v.yx)) * sign(v.xy);
    return normalize(v);
}
/* Provided by Alexander Sannikov */
float3 costheta_unmap(float2 uv)
{
    float phi = uv.x * 2.0 * PI;
    float theta = uv.y * PI;
    return float3(float2(sin(phi), cos(phi)) * sin(theta), cos(theta));
}
/* Decode UV *(-1.0 -> 1.0)* coordinates into a direction. */
inline float3 oct_decode(const float2 e)
{
    #define copysign(a, b) ((a) * sign(b))
    /* Equal-Area Mapping <https://pbr-book.org/4ed/Geometry_and_Transformations/Spherical_Geometry#x3-Equal-AreaMapping> */
    const float2 v = abs(e);
    const float sdist = 1.0 - (v.x + v.y);
    const float r = 1.0 - abs(sdist);
    const float phi = ((v.y - v.x) / r + 1.0) * 0.785398;
    const float r_sqr = r * r;
    const float z = copysign(1.0 - r_sqr, sdist);
    const float cos_phi = copysign(cos(phi), e.x);
    const float sin_phi = copysign(sin(phi), e.y);
    const float r_scl = r * sqrt(2.0 - r_sqr);
    return float3(cos_phi * r_scl, sin_phi * r_scl, z).xyz;
}
/*- end direction mapping -*/

